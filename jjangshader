function Section:Dropdown(config)
	config = config or {}

	local theme = self.Window.Theme
	local values = config.Values or {}
	local multi = config.Multi == true
	local current = config.Value or config.Default

	if multi and type(current) ~= "table" then
		current = {}
	end

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, config.Height or 56)
	holder.LayoutOrder = self:_nextOrder()
	holder.Parent = self.Content

	local title = makeText(holder, {
		Text = config.Title or "Dropdown",
		TextColor3 = config.TextColor or theme.Text,
		TextSize = config.TextSize or 14,
		Font = config.Font or parseWeight(config.FontWeight),
		Size = UDim2.new(1, 0, 0, 20),
	})

	local button = Instance.new("TextButton")
	button.BackgroundColor3 = config.BackgroundColor or theme.Input
	button.BorderSizePixel = 0
	button.Position = UDim2.fromOffset(0, 25)
	button.Size = UDim2.new(1, 0, 0, config.BoxHeight or 27)
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = holder

	round(button, config.Corner or 4)
	stroke(button, theme.SoftBorder, 1, 0.3)

	local label = makeText(button, {
		Text = "",
		TextColor3 = theme.MutedText,
		TextSize = 13,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -30, 1, 0),
	})

	local arrow = createIcon(button, "chevron-down", 14, theme.DimText, 4)

	if arrow then
		arrow.AnchorPoint = Vector2.new(1, 0.5)
		arrow.Position = UDim2.new(1, -8, 0.5, 0)
	end

	local menu = Instance.new("Frame")
	menu.Name = "DropdownMenu"
	menu.BackgroundColor3 = theme.Popup
	menu.BorderSizePixel = 0
	menu.Visible = false
	menu.Position = UDim2.new(0, 0, 1, 4)
	menu.Size = UDim2.new(1, 0, 0, 0)
	menu.AutomaticSize = Enum.AutomaticSize.Y
	menu.ZIndex = 80
	menu.Parent = button

	round(menu, 4)
	stroke(menu, theme.SoftBorder, 1, 0.2)
	padding(menu, 5, 5, 5, 5)

	local menuLayout = list(menu, 3)
	local optionButtons = {}

	local state = {
		Value = current,
		Open = false,
		Locked = config.Locked == true,
	}

	local object = {
		__type = "Dropdown",
		UIElements = {
			Holder = holder,
			Title = title,
			Button = button,
			Menu = menu,
			Label = label,
		},
	}

	local function isSelected(value)
		if multi then
			return table.find(state.Value, value) ~= nil
		end

		return state.Value == value
	end

	local function displayValue()
		if multi then
			if #state.Value == 0 then
				return config.Placeholder or "Select..."
			end

			local parts = {}

			for _, value in ipairs(state.Value) do
				table.insert(parts, tostring(value))
			end

			return table.concat(parts, ", ")
		end

		return state.Value ~= nil and tostring(state.Value)
			or config.Placeholder or "Select..."
	end

	local function refreshLabels()
		label.Text = displayValue()

		for value, option in pairs(optionButtons) do
			option.TextColor3 =
				isSelected(value) and theme.SectionAccent
				or theme.MutedText
		end
	end

	local function rebuild()
		for _, child in ipairs(menu:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		table.clear(optionButtons)

		for index, value in ipairs(values) do
			local option = Instance.new("TextButton")
			option.Name = tostring(value)
			option.BackgroundColor3 = theme.Element
			option.BackgroundTransparency = 0.2
			option.BorderSizePixel = 0
			option.Size = UDim2.new(1, 0, 0, 25)
			option.LayoutOrder = index
			option.Text = tostring(value)
			option.TextColor3 = theme.MutedText
			option.TextSize = 12
			option.Font = theme.Font
			option.AutoButtonColor = false
			option.ZIndex = 82
			option.Parent = menu

			round(option, 3)

			option.MouseButton1Click:Connect(function()
				if state.Locked then
					return
				end

				if multi then
					local found = table.find(state.Value, value)

					if found then
						table.remove(state.Value, found)
					else
						table.insert(state.Value, value)
					end

					refreshLabels()
					safeCallback(config.Callback, state.Value)
				else
					state.Value = value
					refreshLabels()
					object:Close()
					safeCallback(config.Callback, state.Value)
				end
			end)

			optionButtons[value] = option
		end

		refreshLabels()
	end

	function object:Open()
		if state.Locked then
			return self
		end

		state.Open = true
		menu.Visible = true

		if arrow then
			tween(arrow, 0.1, {
				Rotation = 180,
			})
		end

		return self
	end

	function object:Close()
		state.Open = false
		menu.Visible = false

		if arrow then
			tween(arrow, 0.1, {
				Rotation = 0,
			})
		end

		return self
	end

	function object:Set(value, fireCallback)
		if multi then
			state.Value = type(value) == "table" and value or {}
		else
			state.Value = value
		end

		refreshLabels()

		if fireCallback ~= false then
			safeCallback(config.Callback, state.Value)
		end

		return self
	end

	function object:Get()
		return state.Value
	end

	function object:Refresh(newValues)
		values = newValues or {}
		rebuild()
		return self
	end

	button.MouseButton1Click:Connect(function()
		if state.Open then
			object:Close()
		else
			object:Open()
		end
	end)

	attachLockAPI(object, state, button)
	rebuild()
	self:_refreshSize()

	return object
end

function Section:Colorpicker(config)
	config = config or {}

	local window = self.Window
	local theme = window.Theme
	local initial = config.Default or config.Value or Color3.new(1, 1, 1)
	local h, s, v = Color3.toHSV(initial)

