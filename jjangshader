function Window:Notify(config)
	config = config or {}

	local text =
		tostring(
			config.Content
			or config.Text
			or config.Title
			or "Notification"
		)

	local textSize = config.TextSize or 12

	local bounds =
		TextService:GetTextSize(
			text,
			textSize,
			config.Font or self.Theme.Font,
			Vector2.new(config.MaxWidth or 500, 100)
		)

	local width =
		clamp(
			bounds.X + 16,
			config.MinWidth or 90,
			config.MaxWidth or 500
		)

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(width, config.Height or 25)
	holder.LayoutOrder = #self.Notifications + 1
	holder.Parent = self.NotificationHolder

	local card = Instance.new("Frame")
	card.Position = UDim2.fromOffset(-(width + 15), 0)
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = config.BackgroundColor or Color3.fromRGB(17, 18, 18)
	card.BorderSizePixel = 0
	card.Parent = holder

	round(card, config.Corner or 2)
	stroke(card, config.BorderColor or self.Theme.Border, 1, 0.1)

	local label = makeText(card, {
		Text = text,
		TextColor3 = config.TextColor or self.Theme.Text,
		TextSize = textSize,
		Font = config.Font or self.Theme.Font,
		Position = UDim2.fromOffset(7, 0),
		Size = UDim2.new(1, -14, 1, 0),
	})

	local object = {
		__type = "Notification",
		UI = holder,
		Card = card,
		Closed = false,
	}

	function object:Close()
		if self.Closed then
			return
		end

		self.Closed = true

		tween(card, config.SwipeOutTime or 0.11, {
			Position = UDim2.fromOffset(-(width + 15), 0),
			BackgroundTransparency = 1,
		})

		tween(label, config.SwipeOutTime or 0.11, {
			TextTransparency = 1,
		})

		task.delay((config.SwipeOutTime or 0.11) + 0.03, function()
			if holder then
				holder:Destroy()
			end
		end)
	end

	function object:SetText(newText)
		label.Text = tostring(newText)
		return self
	end

	table.insert(self.Notifications, object)

	task.defer(function()
		tween(card, config.SwipeTime or 0.11, {
			Position = UDim2.fromOffset(0, 0),
		})
	end)

	if config.Duration ~= false then
		task.delay(config.Duration or 2.5, function()
			if not object.Closed then
				object:Close()
			end
		end)
	end

	return object
end

