	sidebarContent.BackgroundTransparency = 1
	sidebarContent.Size = UDim2.new(1, -6, 0, 0)
	sidebarContent.AutomaticSize = Enum.AutomaticSize.Y
	sidebarContent.Parent = sidebar

	local sidebarLayout = list(sidebarContent, config.TabGap or 6)

	local separator = Instance.new("Frame")
	separator.BackgroundColor3 = theme.SoftBorder
	separator.BackgroundTransparency = 0.65
	separator.BorderSizePixel = 0
	separator.Position = UDim2.fromOffset(sidebarWidth + 15, 18)
	separator.Size = UDim2.new(0, 1, 1, -36)
	separator.Parent = main

	local contentArea = Instance.new("Frame")
	contentArea.Name = "ContentArea"
	contentArea.BackgroundTransparency = 1
	contentArea.Position = UDim2.fromOffset(sidebarWidth + 24, 8)
	contentArea.Size = UDim2.new(1, -(sidebarWidth + 32), 1, -16)
	contentArea.Parent = main

	--========================================================
	-- NOTIFICATION HOLDER
	--========================================================

	local notificationHolder = Instance.new("Frame")
	notificationHolder.BackgroundTransparency = 1
	notificationHolder.Position = UDim2.fromOffset(2, 2)
	notificationHolder.Size = UDim2.fromOffset(520, 400)
	notificationHolder.ZIndex = 3000
	notificationHolder.Parent = screen

	local notificationLayout = list(notificationHolder, 4)

	--========================================================
	-- OBJECT
	--========================================================

	local window = setmetatable({
		__type = "Window",

		Config = config,
		Theme = theme,

		ScreenGui = screen,
		Root = root,
		Header = header,
		Main = main,
		Sidebar = sidebar,
		SidebarContent = sidebarContent,
		SidebarLayout = sidebarLayout,
		ContentArea = contentArea,
		NotificationHolder = notificationHolder,

		Tabs = {},
		Notifications = {},

		ActiveTab = nil,
		ActiveColorpicker = nil,

		SidebarOrder = 0,
		Visible = true,
		Destroyed = false,
	}, Window)

	--========================================================
	-- DRAGGING
	--========================================================

	if config.Draggable ~= false then
		local dragging = false
		local dragStart
		local startPosition

		local function update(input)
			local delta = input.Position - dragStart

			root.Position =
				UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
		end

		header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragging = true
				dragStart = input.Position
				startPosition = root.Position
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if dragging
				and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				)
			then
				update(input)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragging = false
			end
		end)
	end

	--========================================================
	-- VISIBILITY KEY
	--========================================================

	local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or window.Destroyed then
			return
		end

		if input.KeyCode == toggleKey then
			window:ToggleVisibility()
		end
	end)

	closeButton.MouseButton1Click:Connect(function()
		window:Close()
	end)

	return window
end

return Library
