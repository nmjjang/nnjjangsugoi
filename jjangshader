function Section:Button(config)
	config = config or {}

	local theme = self.Window.Theme
	local height = config.Height or 30

	local button = Instance.new("TextButton")
	button.Name = config.Title or "Button"
	button.BackgroundColor3 = config.Color or theme.Element
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, height)
	button.LayoutOrder = self:_nextOrder()
	button.Text = ""
	button.AutoButtonColor = false
	button.Active = true
	button.Parent = self.Content

	round(button, config.Corner or 4)
	stroke(button, config.BorderColor or theme.SoftBorder, config.BorderThickness or 1, 0.35)

	local iconOffset = 0

	if config.Icon then
		local icon =
			createIcon(
				button,
				config.Icon,
				config.IconSize or 15,
				config.IconColor or theme.Text,
				4
			)

		if icon then
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 9, 0.5, 0)
			iconOffset = (config.IconSize or 15) + 7
		end
	end

	local label = makeText(button, {
		Text = config.Title or "Button",
		TextColor3 = config.TextColor or theme.Text,
		TextTransparency = config.TextTransparency or 0,
		TextSize = config.TextSize or 14,
		Font = config.Font or parseWeight(config.FontWeight),
		Position = UDim2.fromOffset(9 + iconOffset, 0),
		Size = UDim2.new(1, -(18 + iconOffset), 1, 0),
		TextXAlignment = config.TextXAlignment or (config.Icon and "Left" or "Center"),
		ZIndex = 4,
	})

	local state = {
		Locked = config.Locked == true,
	}

	local object = {
		__type = "Button",
		UIElements = {
			Button = button,
			Label = label,
		},
	}

	button.MouseEnter:Connect(function()
		if not state.Locked then
			tween(button, 0.08, {
				BackgroundColor3 = config.HoverColor or theme.ElementHover,
			})
		end
	end)

	button.MouseLeave:Connect(function()
		tween(button, 0.08, {
			BackgroundColor3 = config.Color or theme.Element,
		})
	end)

	button.MouseButton1Click:Connect(function()
		if state.Locked then
			return
		end

		safeCallback(config.Callback)
	end)

	function object:SetText(text)
		label.Text = tostring(text)
		return self
	end

	attachLockAPI(object, state, button)
	self:_refreshSize()

	return object
end

function Section:Checkbox(config)
	config = config or {}

	local theme = self.Window.Theme
	local height = config.Height or 30

	local row = Instance.new("Frame")
	row.Name = config.Title or "Checkbox"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, height)
	row.LayoutOrder = self:_nextOrder()
	row.Parent = self.Content

	local title = makeText(row, {
		Text = config.Title or "Checkbox",
		TextColor3 = config.TextColor or theme.Text,
		TextTransparency = config.TextTransparency or 0,
		TextSize = config.TextSize or 14,
		Font = config.Font or parseWeight(config.FontWeight),
		Size = UDim2.new(1, -90, 1, 0),
		TextXAlignment = config.TextXAlignment or "Left",
	})

	local box = Instance.new("TextButton")
	box.Name = "Checkbox"
	box.AnchorPoint = Vector2.new(1, 0.5)
	box.Position = UDim2.new(1, 0, 0.5, 0)
	box.Size = UDim2.fromOffset(config.BoxSize or 16, config.BoxSize or 16)
	box.BackgroundColor3 = theme.Element
	box.BorderSizePixel = 0
	box.Text = ""
	box.AutoButtonColor = false
	box.Parent = row

	round(box, config.Corner or 4)

	local boxStroke =
		stroke(
			box,
			config.BorderColor or theme.Border,
			config.BorderThickness or 1,
			0.3
		)

	local checkIcon

	if config.CheckboxIcon ~= false then
		checkIcon =
			createIcon(
				box,
				config.CheckboxIcon or "check",
				config.CheckboxIconSize or 11,
				config.CheckboxIconColor or Color3.new(1, 1, 1),
				5
			)

		if checkIcon then
			checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			checkIcon.Position = UDim2.fromScale(0.5, 0.5)
		end
	end

	local state = {
		Value = config.Default == true,
		Locked = config.Locked == true,
	}

	local object = {
		__type = "Checkbox",
		UIElements = {
			Row = row,
			Title = title,
			Box = box,
			Border = boxStroke,
			Check = checkIcon,
		},
	}

	local keybindConfig = config.Keybind

	if keybindConfig == nil or keybindConfig == true then
		keybindConfig = {}
	elseif typeof(keybindConfig) == "EnumItem" or type(keybindConfig) == "string" then
		keybindConfig = { Value = keybindConfig }
	end

	local keybindEnabled = keybindConfig ~= false
	local keybindButton
	local keyState

	if keybindEnabled then
		keybindButton = Instance.new("TextButton")
		keybindButton.Name = "Keybind"
		keybindButton.AnchorPoint = Vector2.new(1, 0.5)
		keybindButton.Position = UDim2.new(1, -28, 0.5, 0)
		keybindButton.Size = UDim2.fromOffset(50, 22)
		keybindButton.BackgroundTransparency = 1
		keybindButton.BorderSizePixel = 0
		keybindButton.TextColor3 = theme.DimText
		keybindButton.TextSize = 12
		keybindButton.Font = theme.Font
		keybindButton.TextXAlignment = Enum.TextXAlignment.Right
		keybindButton.AutoButtonColor = false
		keybindButton.Parent = row

		local initial = type(keybindConfig) == "table" and (keybindConfig.Value or keybindConfig.Default) or nil

		if type(initial) == "string" then
			initial = Enum.KeyCode[initial]
		end

		keyState = {
			Value = typeof(initial) == "EnumItem" and initial or nil,
			Picking = false,
		}

		local function renderKey()
			if keyState.Picking then
				keybindButton.Text = "..."
				keybindButton.TextColor3 = theme.SectionAccent
			elseif keyState.Value then
				keybindButton.Text = keyState.Value.Name
				keybindButton.TextColor3 = theme.MutedText
			else
				keybindButton.Text = "="
				keybindButton.TextColor3 = theme.DimText
			end
		end

		keybindButton.MouseButton1Click:Connect(function()
			if state.Locked then
				return
			end

			keyState.Picking = true
			renderKey()
		end)

		local connection

		connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if not row.Parent then
				connection:Disconnect()
				return
			end

			if input.KeyCode == Enum.KeyCode.Unknown then
				return
			end

			if keyState.Picking then
				if input.KeyCode == Enum.KeyCode.Escape then
					keyState.Picking = false
					renderKey()
					return
				end

				if input.KeyCode == Enum.KeyCode.Backspace
					or input.KeyCode == Enum.KeyCode.Delete
				then
					keyState.Value = nil
					keyState.Picking = false
					renderKey()
					safeCallback(keybindConfig.Callback, nil)
					return
				end

				keyState.Value = input.KeyCode
				keyState.Picking = false
				renderKey()
				safeCallback(keybindConfig.Callback, keyState.Value)
				return
			end

			if not gameProcessed
				and not state.Locked
				and keyState.Value
				and input.KeyCode == keyState.Value
			then
				object:Set(not state.Value, true)
				safeCallback(keybindConfig.OnTriggered, state.Value, keyState.Value)
			end
		end)

		renderKey()
	end

	local function render(animated)
		local activeColor = config.ActiveColor or self.Window.Theme.SectionAccent
		local inactiveColor = config.InactiveColor or theme.Element

		if animated then
			tween(box, 0.08, {
				BackgroundColor3 = state.Value and activeColor or inactiveColor,
			})
		else
			box.BackgroundColor3 = state.Value and activeColor or inactiveColor
		end

		boxStroke.Color =
			state.Value and (config.ActiveBorderColor or activeColor)
			or (config.BorderColor or theme.Border)

		if checkIcon then
			checkIcon.Visible = state.Value
		end
	end

	function object:Set(value, fireCallback)
		state.Value = value == true
		render(true)

		if fireCallback ~= false then
			safeCallback(config.Callback, state.Value)
		end

		return self
	end

	function object:Get()
		return state.Value
	end

	function object:Toggle(fireCallback)
		return self:Set(not state.Value, fireCallback)
	end

	function object:SetKeybind(value)
		if not keyState then
			return self
		end

		if type(value) == "string" then
			value = Enum.KeyCode[value]
		end

		keyState.Value = typeof(value) == "EnumItem" and value or nil
		keyState.Picking = false

		if keybindButton then
			keybindButton.Text = keyState.Value and keyState.Value.Name or "="
		end

		return self
	end

	function object:GetKeybind()
		return keyState and keyState.Value or nil
	end

	box.MouseButton1Click:Connect(function()
		if not state.Locked then
			object:Set(not state.Value, true)
		end
	end)

	attachLockAPI(object, state, box)
	render(false)
	self:_refreshSize()

	return object
end

function Section:Toggle(config)
	return self:Checkbox(config)
end

function Section:Keybind(config)
	config = config or {}

	local theme = self.Window.Theme
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, config.Height or 30)
	row.LayoutOrder = self:_nextOrder()
	row.Parent = self.Content

	local title = makeText(row, {
		Text = config.Title or "Keybind",
		TextColor3 = config.TextColor or theme.Text,
		TextSize = config.TextSize or 14,
		Font = config.Font or parseWeight(config.FontWeight),
		Size = UDim2.new(1, -80, 1, 0),
	})

	local display = Instance.new("TextButton")
	display.AnchorPoint = Vector2.new(1, 0.5)
	display.Position = UDim2.new(1, 0, 0.5, 0)
	display.Size = UDim2.fromOffset(72, 24)
	display.BackgroundColor3 = theme.Element
	display.BorderSizePixel = 0
	display.AutoButtonColor = false
	display.TextColor3 = theme.MutedText
	display.TextSize = 12
	display.Font = theme.Font
	display.Parent = row

	round(display, 4)
	stroke(display, theme.SoftBorder, 1, 0.3)

	local value = config.Value or config.Default

	if type(value) == "string" then
		value = Enum.KeyCode[value]
	end

	local state = {
		Value = typeof(value) == "EnumItem" and value or nil,
		Locked = config.Locked == true,
		Picking = false,
	}

	local object = {
		__type = "Keybind",
		UIElements = {
			Row = row,
			Title = title,
			Display = display,
		},
	}

	local function render()
		display.Text =
			state.Picking and "..."
			or state.Value and state.Value.Name
			or "="
	end

	display.MouseButton1Click:Connect(function()
		if state.Locked then
			return
		end

		state.Picking = true
		render()
	end)

	local connection

	connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not row.Parent then
			connection:Disconnect()
			return
		end

		if input.KeyCode == Enum.KeyCode.Unknown then
			return
		end

		if state.Picking then
			if input.KeyCode == Enum.KeyCode.Escape then
				state.Picking = false
				render()
				return
			end

			if input.KeyCode == Enum.KeyCode.Backspace
				or input.KeyCode == Enum.KeyCode.Delete
			then
				state.Value = nil
			else
				state.Value = input.KeyCode
			end

			state.Picking = false
			render()
			safeCallback(config.Callback, state.Value)
			return
		end

		if not gameProcessed
			and not state.Locked
			and state.Value
			and input.KeyCode == state.Value
		then
			safeCallback(config.OnTriggered, state.Value)
		end
	end)

	function object:Set(newValue, fireCallback)
		if type(newValue) == "string" then
			newValue = Enum.KeyCode[newValue]
		end

		state.Value = typeof(newValue) == "EnumItem" and newValue or nil
		state.Picking = false
		render()

		if fireCallback ~= false then
			safeCallback(config.Callback, state.Value)
		end

		return self
	end

	function object:Get()
		return state.Value
	end

	attachLockAPI(object, state, display)
	render()
	self:_refreshSize()

	return object
end

function Section:Slider(config)
	config = config or {}

	local theme = self.Window.Theme
	local min = tonumber(config.Min) or 0
	local max = tonumber(config.Max) or 100

	if min > max then
		min, max = max, min
	end

	local increment = tonumber(config.Increment) or tonumber(config.Step) or 1

	if increment <= 0 then
		increment = 1
	end

	local function inferDecimals(number)
		if config.Decimals ~= nil then
			return math.max(0, math.floor(tonumber(config.Decimals) or 0))
		end

		local decimals = 0
		local scaled = math.abs(number)

		while decimals < 10
			and math.abs(scaled - math.floor(scaled + 0.5)) > 1e-9
		do
			scaled *= 10
			decimals += 1
		end

		return decimals
	end

	local decimals = inferDecimals(increment)
	local scale = 10 ^ decimals

	local function snap(value)
		value = clamp(tonumber(value) or min, min, max)

		local steps = math.floor((((value - min) / increment) + 0.5))
		local snapped = min + steps * increment

		snapped = clamp(snapped, min, max)
		snapped = math.floor(snapped * scale + 0.5) / scale

		return snapped
	end

	local default = snap(tonumber(config.Default or config.Value) or min)

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, config.Height or 48)
	holder.LayoutOrder = self:_nextOrder()
	holder.Parent = self.Content

	local title = makeText(holder, {
		Text = config.Title or "Slider",
		TextColor3 = config.TextColor or theme.Text,
		TextSize = config.TextSize or 14,
		Font = config.Font or parseWeight(config.FontWeight),
		Size = UDim2.new(1, -80, 0, 20),
	})

	local valueText = makeText(holder, {
		Text = "",
		TextColor3 = config.ValueColor or theme.MutedText,
		TextSize = config.ValueTextSize or 12,
		Font = theme.Font,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(75, 20),
		TextXAlignment = "Right",
	})

	local track = Instance.new("TextButton")
	track.BackgroundColor3 = config.TrackColor or theme.Element
	track.BorderSizePixel = 0
	track.Position = UDim2.fromOffset(0, 32)
	track.Size = UDim2.new(1, 0, 0, config.TrackHeight or 4)
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = holder

	round(track, 99)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = config.FillColor or theme.SectionAccent
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.Parent = track

	round(fill, 99)

	local knob = Instance.new("Frame")
	knob.BackgroundColor3 = config.KnobColor or theme.Text
	knob.BorderSizePixel = 0
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(config.KnobSize or 11, config.KnobSize or 11)
	knob.Parent = track

	round(knob, 99)

	local state = {
		Value = default,
		Locked = config.Locked == true,
		Dragging = false,
	}

	local object = {
		__type = "Slider",
		UIElements = {
			Holder = holder,
			Title = title,
			Value = valueText,
			Track = track,
			Fill = fill,
			Knob = knob,
		},
	}

	local function formatValue(value)
		if config.Format then
			local ok, result = pcall(config.Format, value)

			if ok and result ~= nil then
				return tostring(result)
			end
		end

		if decimals > 0 then
			return string.format("%." .. decimals .. "f", value)
		end

		return tostring(value)
	end

	local function render()
		local range = max - min
		local ratio = range == 0 and 0 or clamp((state.Value - min) / range, 0, 1)

		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, 0, 0.5, 0)

		valueText.Text =
			(config.Prefix or "")
			.. formatValue(state.Value)
			.. (config.Suffix or "")
	end

	function object:Set(value, fireCallback)
		state.Value = snap(tonumber(value) or state.Value)
		render()

		if fireCallback ~= false then
			safeCallback(config.Callback, state.Value)
		end

		return self
	end

	function object:Get()
		return state.Value
	end

	function object:SetRange(newMin, newMax)
		min = tonumber(newMin) or min
		max = tonumber(newMax) or max

		if min > max then
			min, max = max, min
		end

		object:Set(state.Value, false)
		return self
	end

	local function updateX(x)
		local ratio =
			clamp(
				(x - track.AbsolutePosition.X)
				/ math.max(1, track.AbsoluteSize.X),
				0,
				1
			)

		object:Set(min + ((max - min) * ratio), true)
	end

	track.InputBegan:Connect(function(input)
		if state.Locked then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			state.Dragging = true
			updateX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not state.Dragging or state.Locked then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			updateX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			state.Dragging = false
		end
	end)

	attachLockAPI(object, state, track)
	render()
	self:_refreshSize()

	return object
end

