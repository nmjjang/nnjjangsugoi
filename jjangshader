local function attachLockAPI(object, state, visual)
	function object:Lock()
		state.Locked = true

		if visual then
			visual.Active = false
			visual.BackgroundTransparency = math.max(visual.BackgroundTransparency, 0.25)
		end

		return self
	end

	function object:Unlock()
		state.Locked = false

		if visual then
			visual.Active = true
		end

		return self
	end

	function object:IsLocked()
		return state.Locked
	end
end

function Section:_nextOrder()
	self.Order += 1
	return self.Order
end

function Section:_refreshSize()
	if not self.Frame then
		return
	end

	if not self.Opened then
		self.Frame.Size = UDim2.new(1, 0, 0, self.HeaderHeight)
		return
	end

	task.defer(function()
		if not self.Frame or not self.ContentLayout then
			return
		end

		self.Frame.Size =
			UDim2.new(
				1,
				0,
				0,
				self.HeaderHeight
					+ self.ContentLayout.AbsoluteContentSize.Y
					+ self.PaddingBottom
			)
	end)
end

