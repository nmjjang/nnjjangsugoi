		config.Box == false and 1
		or config.BackgroundTransparency
		or 0

	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 0, 40)
	frame.LayoutOrder = self.SectionOrder + 1
	frame.Parent = self.Content

	self.SectionOrder += 1

	if config.Box ~= false then
		round(frame, config.Corner or 5)
		stroke(
			frame,
			config.BorderColor or theme.SoftBorder,
			config.BorderThickness or 1,
			config.BorderTransparency == nil and 0.25 or config.BorderTransparency
		)
	end

	local headerHeight =
		config.HeaderHeight
		or ((config.Title and config.Title ~= "") and 30 or 0)

	local header = Instance.new("TextButton")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.BorderSizePixel = 0
	header.Size = UDim2.new(1, 0, 0, headerHeight)
	header.Text = ""
	header.AutoButtonColor = false
	header.Parent = frame

	local title = makeText(header, {
		Text = config.Title or "",
		TextColor3 = config.TextColor or theme.SectionAccent,
		TextTransparency = config.TextTransparency or 0.05,
		TextSize = config.TextSize or 17,
		Font = config.Font or parseWeight(config.FontWeight or "SemiBold"),
		Position = UDim2.fromOffset(config.TitlePadding or 4, 0),
		Size = UDim2.new(1, -34, 1, 0),
		TextXAlignment = config.TextXAlignment or "Left",
	})

	local chevron

	if config.Collapsible ~= false and headerHeight > 0 then
		chevron =
			createIcon(
				header,
				"chevron-down",
				14,
				config.ChevronColor or theme.DimText,
				4
			)

		if chevron then
			chevron.AnchorPoint = Vector2.new(1, 0.5)
			chevron.Position = UDim2.new(1, -4, 0.5, 0)
		end
	end

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Position = UDim2.fromOffset(
		config.ContentPaddingLeft or 4,
		headerHeight
	)

	content.Size = UDim2.new(
		1,
		-((config.ContentPaddingLeft or 4) + (config.ContentPaddingRight or 4)),
		0,
		0
	)

	content.AutomaticSize = Enum.AutomaticSize.Y
	content.Parent = frame

	local layout = list(content, config.ElementGap or 6)

	local section = setmetatable({
		__type = "Section",
		Window = self.Window,
		Tab = self,
		Frame = frame,
		Header = header,
		Title = title,
		Content = content,
		ContentLayout = layout,
		HeaderHeight = headerHeight,
		PaddingBottom = config.PaddingBottom or 7,
		Order = 0,
		Opened = config.Opened == nil and true or config.Opened,
	}, Section)

	content.Visible = section.Opened

	if chevron then
		chevron.Rotation = section.Opened and 0 or -90
	end

	function section:SetOpened(opened)
		self.Opened = opened == true
		self.Content.Visible = self.Opened

		if chevron then
			tween(chevron, 0.1, {
				Rotation = self.Opened and 0 or -90,
			})
		end

		self:_refreshSize()
		return self
	end

	function section:Toggle()
		return self:SetOpened(not self.Opened)
	end

	header.MouseButton1Click:Connect(function()
		if config.Collapsible ~= false then
			section:Toggle()
		end
	end)

	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		section:_refreshSize()
	end)

	section:_refreshSize()

	return section
end

