local ICONS_URL = "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"
local Lucide

do
	local ok, result = pcall(function()
		return loadstring(game:HttpGet(ICONS_URL))()
	end)

	if ok then
		Lucide = result

		if Lucide and Lucide.SetIconsType then
			Lucide.SetIconsType("lucide")
		end
	else
		warn("[SketchPanelUI] Failed to load Lucide:", result)
	end
end

local function createIcon(parent, iconName, size, color, zIndex)
	if not iconName or iconName == "" or not Lucide then
		return nil
	end

	local ok, iconData = pcall(function()
		return Lucide.Icon2(iconName)
	end)

	if not ok or not iconData then
		warn("[SketchPanelUI] Lucide icon not found:", iconName)
		return nil
	end

	local icon = Instance.new("ImageLabel")
	icon.Name = "Icon_" .. tostring(iconName)
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromOffset(size or 16, size or 16)
	icon.ImageColor3 = color or Color3.new(1, 1, 1)
	icon.ZIndex = zIndex or 3

	if type(iconData) == "table" then
		icon.Image = iconData[1]

		if iconData[2] then
			icon.ImageRectSize = iconData[2].ImageRectSize
			icon.ImageRectOffset = iconData[2].ImageRectPosition
		end
	elseif type(iconData) == "string" then
		icon.Image = iconData
	end

	icon.Parent = parent

	return icon
end

