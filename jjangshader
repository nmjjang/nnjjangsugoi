	local popupWidth = config.PopupWidth or 270
	local fieldHeight = config.FieldHeight or 130
	local bottomHeight = config.BottomHeight or 46
	local popupHeight = fieldHeight + bottomHeight

	local popup = Instance.new("Frame")
	popup.Name = "ColorpickerPopup"
	popup.BackgroundColor3 = theme.Popup
	popup.BorderSizePixel = 0
	popup.Visible = false
	popup.Size = UDim2.fromOffset(popupWidth, popupHeight)
	popup.ZIndex = 1000
	popup.Parent = window.ScreenGui

	round(popup, 6)
	stroke(popup, theme.Border, 1, 0.15)

	local sv = Instance.new("TextButton")
	sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
	sv.BorderSizePixel = 0
	sv.Text = ""
	sv.Size = UDim2.new(1, 0, 0, fieldHeight)
	sv.AutoButtonColor = false
	sv.ZIndex = 1001
	sv.Parent = popup

	local white = Instance.new("Frame")
	white.BackgroundColor3 = Color3.new(1, 1, 1)
	white.BorderSizePixel = 0
	white.Size = UDim2.fromScale(1, 1)
	white.ZIndex = 1002
	white.Parent = sv

	local whiteGradient = Instance.new("UIGradient")
	whiteGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	whiteGradient.Parent = white

	local black = Instance.new("Frame")
	black.BackgroundColor3 = Color3.new(0, 0, 0)
	black.BorderSizePixel = 0
	black.Size = UDim2.fromScale(1, 1)
	black.ZIndex = 1003
	black.Parent = sv

	local blackGradient = Instance.new("UIGradient")
	blackGradient.Rotation = 90
	blackGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	blackGradient.Parent = black

	local picker = Instance.new("Frame")
	picker.AnchorPoint = Vector2.new(0.5, 0.5)
	picker.Size = UDim2.fromOffset(20, 20)
	picker.BackgroundTransparency = 1
	picker.ZIndex = 1006
	picker.Parent = sv

	round(picker, 99)
	stroke(picker, Color3.new(1, 1, 1), 2, 0)

	local hue = Instance.new("TextButton")
	hue.BackgroundColor3 = Color3.new(1, 1, 1)
	hue.BorderSizePixel = 0
	hue.Text = ""
	hue.AutoButtonColor = false
	hue.Position = UDim2.new(0, 12, 1, -27)
	hue.Size = UDim2.new(1, -24, 0, 8)
	hue.ZIndex = 1002
	hue.Parent = popup

	round(hue, 99)

	local hueGradient = Instance.new("UIGradient")
	hueGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 40, 40)),
		ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 70, 255)),
		ColorSequenceKeypoint.new(0.82, Color3.fromRGB(210, 0, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 25, 65)),
	})
	hueGradient.Parent = hue

	local hueKnob = Instance.new("Frame")
	hueKnob.AnchorPoint = Vector2.new(0.5, 0.5)
	hueKnob.Size = UDim2.fromOffset(20, 20)
	hueKnob.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
	hueKnob.BorderSizePixel = 0
	hueKnob.ZIndex = 1005
	hueKnob.Parent = hue

	round(hueKnob, 99)
	stroke(hueKnob, Color3.new(1, 1, 1), 2, 0)

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -5, 0, 5)
	close.Size = UDim2.fromOffset(19, 19)
	close.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
	close.BorderSizePixel = 0
	close.Text = "×"
	close.TextColor3 = Color3.new(1, 1, 1)
	close.TextSize = 17
	close.Font = Enum.Font.GothamBold
	close.ZIndex = 1020
	close.Parent = popup

	round(close, 4)

	local state = {
		Value = initial,
		Locked = config.Locked == true,
		Open = false,
	}

	local object = {
		__type = "Colorpicker",
		UIElements = {
			Row = row,
			Title = title,
			Swatch = swatch,
			Popup = popup,
			SV = sv,
			Picker = picker,
			Hue = hue,
			HueKnob = hueKnob,
			Close = close,
		},
	}

	local function positionPopup()
		local camera = workspace.CurrentCamera
		local screenSize =
			camera and camera.ViewportSize
			or Vector2.new(1920, 1080)

		local pos = swatch.AbsolutePosition
		local size = swatch.AbsoluteSize

		local x = pos.X + size.X - popupWidth
		local y = pos.Y + size.Y + 6

		if y + popupHeight > screenSize.Y - 6 then
			y = pos.Y - popupHeight - 6
		end

		x = clamp(x, 6, math.max(6, screenSize.X - popupWidth - 6))
		y = clamp(y, 6, math.max(6, screenSize.Y - popupHeight - 6))

		popup.Position = UDim2.fromOffset(x, y)
	end

	local function render(fireCallback)
		state.Value = Color3.fromHSV(h, s, v)
		local hueColor = Color3.fromHSV(h, 1, 1)

		swatch.BackgroundColor3 = state.Value
		sv.BackgroundColor3 = hueColor
		picker.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
		hueKnob.BackgroundColor3 = hueColor

		if fireCallback ~= false then
			safeCallback(config.Callback, state.Value)
		end
	end

	local draggingSV = false
	local draggingHue = false

	local function updateSV(position)
		s =
			clamp(
				(position.X - sv.AbsolutePosition.X)
				/ math.max(1, sv.AbsoluteSize.X),
				0,
				1
			)

		v =
			1 - clamp(
				(position.Y - sv.AbsolutePosition.Y)
					/ math.max(1, sv.AbsoluteSize.Y),
				0,
				1
			)

		render(true)
	end

	local function updateHue(position)
		h =
			clamp(
				(position.X - hue.AbsolutePosition.X)
				/ math.max(1, hue.AbsoluteSize.X),
				0,
				1
			)

		render(true)
	end

	sv.InputBegan:Connect(function(input)
		if state.Locked then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			draggingSV = true
			updateSV(input.Position)
		end
	end)

	hue.InputBegan:Connect(function(input)
		if state.Locked then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			draggingHue = true
			updateHue(input.Position)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if state.Locked then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			if draggingSV then
				updateSV(input.Position)
			end

			if draggingHue then
				updateHue(input.Position)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			draggingSV = false
			draggingHue = false
		end
	end)

	function object:Set(color, fireCallback)
		if typeof(color) ~= "Color3" then
			return self
		end

		h, s, v = Color3.toHSV(color)
		render(fireCallback)

		return self
	end

	function object:Get()
		return state.Value
	end

	function object:Open()
		if state.Locked then
			return self
		end

		if window.ActiveColorpicker and window.ActiveColorpicker ~= self then
			window.ActiveColorpicker:Close()
		end

		window.ActiveColorpicker = self
		state.Open = true
		popup.Visible = true

		task.defer(function()
			positionPopup()
			render(false)
		end)

		return self
	end

	function object:Close()
		state.Open = false
		popup.Visible = false

		if window.ActiveColorpicker == self then
			window.ActiveColorpicker = nil
		end

		return self
	end

	function object:Toggle()
		if state.Open then
			return self:Close()
		end

		return self:Open()
	end

	swatch.MouseButton1Click:Connect(function()
		object:Toggle()
	end)

	close.MouseButton1Click:Connect(function()
		object:Close()
	end)

	attachLockAPI(object, state, swatch)
	render(false)
	self:_refreshSize()

	return object
end

