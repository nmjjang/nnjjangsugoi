local function clamp(v, a, b)
	return math.max(a, math.min(b, v))
end

local function safeCallback(callback, ...)
	if type(callback) ~= "function" then
		return
	end

	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[SketchPanelUI] Callback error:", err)
	end
end

local function copyTable(tbl)
	local out = {}

	for k, v in pairs(tbl or {}) do
		if type(v) == "table" then
			out[k] = copyTable(v)
		else
			out[k] = v
		end
	end

	return out
end

local function merge(base, override)
	local out = copyTable(base)

	for k, v in pairs(override or {}) do
		if type(v) == "table" and type(out[k]) == "table" then
			out[k] = merge(out[k], v)
		else
			out[k] = v
		end
	end

	return out
end

local function tween(object, time, properties)
	local animation = TweenService:Create(
		object,
		TweenInfo.new(time or 0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		properties
	)

	animation:Play()
	return animation
end

local function round(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 7)
	corner.Parent = parent

	return corner
end

local function stroke(parent, color, thickness, transparency)
	local uiStroke = Instance.new("UIStroke")
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Color = color or Color3.fromRGB(155, 155, 155)
	uiStroke.Thickness = thickness or 1
	uiStroke.Transparency = transparency or 0
	uiStroke.Parent = parent

	return uiStroke
end

local function padding(parent, left, right, top, bottom)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, left or 0)
	pad.PaddingRight = UDim.new(0, right or 0)
	pad.PaddingTop = UDim.new(0, top or 0)
	pad.PaddingBottom = UDim.new(0, bottom or 0)
	pad.Parent = parent

	return pad
end

local function list(parent, gap)
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, gap or 0)
	layout.Parent = parent

	return layout
end

local function parseXAlignment(value)
	if typeof(value) == "EnumItem" then
		return value
	end

	local stringValue = string.lower(tostring(value or "left"))

	if stringValue == "center" then
		return Enum.TextXAlignment.Center
	elseif stringValue == "right" then
		return Enum.TextXAlignment.Right
	end

	return Enum.TextXAlignment.Left
end

local function parseWeight(value)
	local weight = string.lower(tostring(value or "regular"))

	if weight == "bold" then
		return Enum.Font.GothamBold
	elseif weight == "semibold" or weight == "semi bold" or weight == "medium" then
		return Enum.Font.GothamMedium
	elseif weight == "light" then
		return Enum.Font.Gotham
	end

	return Enum.Font.Gotham
end

local function makeText(parent, config)
	config = config or {}

	local label = Instance.new(config.Button and "TextButton" or "TextLabel")

	label.BackgroundTransparency =
		config.BackgroundTransparency == nil and 1 or config.BackgroundTransparency

	label.BackgroundColor3 =
		config.BackgroundColor3 or Color3.new(1, 1, 1)

	label.BorderSizePixel = 0
	label.Text = tostring(config.Text or "")
	label.TextColor3 = config.TextColor3 or Color3.new(1, 1, 1)
	label.TextTransparency = config.TextTransparency or 0
	label.TextSize = config.TextSize or 14
	label.Font = config.Font or parseWeight(config.FontWeight)
	label.TextXAlignment = parseXAlignment(config.TextXAlignment)
	label.TextYAlignment = config.TextYAlignment or Enum.TextYAlignment.Center
	label.TextWrapped = config.TextWrapped == true
	label.RichText = config.RichText == true
	label.Size = config.Size or UDim2.new(1, 0, 0, 24)
	label.Position = config.Position or UDim2.new()
	label.AnchorPoint = config.AnchorPoint or Vector2.new()
	label.ZIndex = config.ZIndex or 1
	label.Visible = config.Visible == nil and true or config.Visible

	if label:IsA("TextButton") then
		label.AutoButtonColor = false
	end

	label.Parent = parent

	return label
end

