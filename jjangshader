function Window:Tab(config)
	config = config or {}

	local theme = self.Theme

	local button = Instance.new("TextButton")
	button.Name = config.Title or "Tab"
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, config.Height or 43)
	button.LayoutOrder = self.SidebarOrder + 1
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = self.SidebarContent

	self.SidebarOrder += 1

	local icon =
		createIcon(
			button,
			config.Icon,
			config.IconSize or 19,
			config.IconColor or theme.DimText,
			4
		)

	local iconOffset = 0

	if icon then
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 8, 0.5, 0)
		iconOffset = (config.IconSize or 19) + 10
	end

	local label = makeText(button, {
		Text = config.Title or "Tab",
		TextColor3 = config.TextColor or theme.Text,
		TextTransparency = config.TextTransparency or 0,
		TextSize = config.TextSize or 16,
		Font = config.Font or parseWeight(config.FontWeight),
		Position = UDim2.fromOffset(8 + iconOffset, 0),
		Size = UDim2.new(1, -(8 + iconOffset), 1, 0),
		TextXAlignment = config.TextXAlignment or "Left",
		ZIndex = 4,
	})

	local content = Instance.new("ScrollingFrame")
	content.Name = (config.Title or "Tab") .. "_Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Position = UDim2.fromOffset(0, 0)
	content.Size = UDim2.fromScale(1, 1)
	content.CanvasSize = UDim2.new(0, 0, 0, 0)
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.ScrollBarThickness = config.ScrollBarThickness or 4
	content.ScrollBarImageColor3 = config.ScrollBarColor or theme.Text
	content.Visible = false
	content.Parent = self.ContentArea

	padding(content, 10, 14, 12, 16)
	local contentLayout = list(content, config.SectionGap or 9)

	local tab = setmetatable({
		__type = "Tab",
		Window = self,
		Button = button,
		Label = label,
		Icon = icon,
		Content = content,
		ContentLayout = contentLayout,
		SectionOrder = 0,
	}, Tab)

	table.insert(self.Tabs, tab)

	function tab:Select()
		self.Window:SelectTab(self)
		return self
	end

	button.MouseButton1Click:Connect(function()
		tab:Select()
	end)

	if not self.ActiveTab then
		self:SelectTab(tab)
	end

	return tab
end

function Window:SelectTab(tab)
	if self.ActiveTab == tab then
		return
	end

	for _, current in ipairs(self.Tabs) do
		local active = current == tab

		current.Content.Visible = active

		if current.Icon then
			current.Icon.ImageColor3 =
				active and self.Theme.SectionAccent
				or self.Theme.DimText
		end

		current.Label.TextColor3 =
			active and self.Theme.Text
			or self.Theme.MutedText
	end

	self.ActiveTab = tab
end

